/*.......1.........2.........3.........4.........5.........6.........7.........8
================================================================================

FILE analog/varistor/ifspec.ifs

  Interface specification for the analog varistor codemodel.
  LTspice-compatible voltage-controlled resistor.

  Ports:
    IN+  — controlling voltage input (positive)
    IN-  — controlling voltage input (negative)
    OUT  — floating conductance (inout/gd)

  Parameters:
    vref   — clamp voltage (default 1.0 V)
    roff   — off resistance (default 1e12 ohm)
    rclamp — clamp resistance (default 1.0 ohm)

================================================================================*/

NAME_TABLE:


C_Function_Name:       cm_varistor
Spice_Model_Name:      varistor
Description:           "Voltage-controlled resistor (varistor/clamp)"


PORT_TABLE:


Port_Name:             in_pos             in_neg             out
Description:           "control voltage+"  "control voltage-"  "output conductance"
Direction:             in                 in                 inout
Default_Type:          v                  v                  gd
Allowed_Types:         [v,vd,i,id,vnam]   [v,vd,i,id,vnam]   [gd]
Vector:                 no                 no                 no
Vector_Bounds:          -                  -                  -
Null_Allowed:          no                 no                 no


PARAMETER_TABLE:


Parameter_Name:     vref                roff                rclamp
Description:        "clamp voltage"     "off resistance"    "clamp resistance"
Data_Type:          real                real                real
Default_Value:      1.0                 1e12                1.0
Limits:             [0 -]               [1e-9 -]            [1e-9 -]
Vector:              no                  no                  no
Vector_Bounds:       -                   -                   -
Null_Allowed:       yes                 yes                 yes

