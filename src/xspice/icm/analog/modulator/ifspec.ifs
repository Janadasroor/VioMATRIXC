/*.......1.........2.........3.........4.........5.........6.........7.........8
================================================================================

FILE analog/modulator/ifspec.ifs

  Interface specification for the analog modulator (quadrature) codemodel.
  LTspice-compatible MODULATOR A-device replacement.

  Ports:
    FM_IN   — frequency modulation control voltage (in/v)
    AM_IN   — amplitude modulation control voltage (in/v)
    COS_OUT — cosine quadrature output (out/v)
    SIN_OUT — sine quadrature output (out/v)

  Parameters:
    mark  — frequency when V(fm_in) = 1V (default 1e6 Hz)
    space — frequency when V(fm_in) = 0V (default 5e5 Hz)

  Formula:
    freq    = space + (mark - space) * V(fm_in)
    cos_out = V(am_in) * cos(2*pi*phase)
    sin_out = V(am_in) * sin(2*pi*phase)

================================================================================*/

NAME_TABLE:


C_Function_Name:       cm_modulator
Spice_Model_Name:      modulator
Description:           "Quadrature sine/cosine modulator with FM and AM inputs"


PORT_TABLE:


Port_Name:             fm_in              am_in              cos_out            sin_out
Description:           "FM control voltage" "AM control voltage" "cosine output"  "sine output"
Direction:             in                 in                 out                out
Default_Type:          v                  v                  v                  v
Allowed_Types:         [v,vd,i,id,vnam]   [v,vd,i,id,vnam]   [v,vd,i,id]        [v,vd,i,id]
Vector:                 no                 no                 no                 no
Vector_Bounds:          -                  -                  -                  -
Null_Allowed:          no                 no                 no                 no


PARAMETER_TABLE:


Parameter_Name:     mark                space
Description:        "mark frequency"    "space frequency"
Data_Type:          real                real
Default_Value:      1e6                 5e5
Limits:             [0 -]               [0 -]
Vector:              no                  no
Vector_Bounds:       -                   -
Null_Allowed:       yes                 yes

