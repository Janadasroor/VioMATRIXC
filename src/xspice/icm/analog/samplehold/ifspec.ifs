/*.......1.........2.........3.........4.........5.........6.........7.........8
================================================================================

FILE analog/samplehold/ifspec.ifs

  Interface specification for the analog sample-and-hold codemodel.
  LTspice-compatible SAMPLEHOLD A-device replacement.

  Ports:
    IN  — analog input (in/v)
    CLK — clock input (in/v)
    OUT — sampled output (out/v)

  Parameters:
    vt     — clock threshold voltage (default 2.5 V)
    vhigh  — output high clamp (default 5 V)
    vlow   — output low clamp (default 0 V)

  Behavior:
    Edge-triggered sample on clock rising edge crossing vt.
    Output = clamp(input, vlow, vhigh) between samples (zero-order hold).

================================================================================*/

NAME_TABLE:


C_Function_Name:       cm_samplehold
Spice_Model_Name:      samplehold
Description:           "Sample and hold (edge-triggered, zero-order hold)"


PORT_TABLE:


Port_Name:             in                 clk                out
Description:           "analog input"     "clock input"      "sampled output"
Direction:             in                 in                 out
Default_Type:          v                  v                  v
Allowed_Types:         [v,vd,i,id,vnam]   [v,vd,i,id,vnam]   [v,vd,i,id]
Vector:                 no                 no                 no
Vector_Bounds:          -                  -                  -
Null_Allowed:          no                 no                 no


PARAMETER_TABLE:


Parameter_Name:     vt                  vhigh               vlow
Description:        "threshold voltage" "output high clamp" "output low clamp"
Data_Type:          real                real                real
Default_Value:      2.5                 5.0                 0.0
Limits:             [0 -]               [- -]               [- -]
Vector:              no                  no                  no
Vector_Bounds:       -                   -                   -
Null_Allowed:       yes                 yes                 yes

